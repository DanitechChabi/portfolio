# --- Administration (identifiant + mot de passe) ---
# Identifiant et mot de passe de connexion à /admin.
# Changer le mot de passe déconnecte toutes les sessions ouvertes.
ADMIN_USERNAME=daniel
ADMIN_PASSWORD=choisir-un-mot-de-passe-long

# Secret de signature des sessions (optionnel).
# Sans lui, il est dérivé de l'identifiant et du mot de passe — ce qui
# suffit et invalide les sessions au changement de mot de passe.
# Définissez-le seulement pour conserver les sessions malgré un changement
# de mot de passe (32+ caractères aléatoires).
# SESSION_SECRET=

# --- Stockage Vercel Blob (https://vercel.com → Storage → Blob) ---
# Sert au contenu de l'admin (articles, compétences, parcours, profil,
# messages) et aux images téléversées. Sans cette clé, le site public
# affiche le contenu par défaut embarqué dans le code.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_votre_cle

# --- Contact (https://resend.com) ---
RESEND_API_KEY=re_votre_cle
CONTACT_EMAIL=votre-email@exemple.com

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://danielchabi.vercel.app

# --- Chat « L'Archiviste » (https://openrouter.ai → Keys) ---
# Clé du serveur uniquement (jamais préfixée NEXT_PUBLIC_) : sans elle, le
# widget n'apparaît pas dans les pages et /api/chat répond « salle fermée ».
OPENROUTER_API_KEY=sk-or-v1_votre_cle

# Modèle de conversation (optionnel) — bascule sans redéploiement.
# Défaut : z-ai/glm-5.3-flash. Alternatives économiques :
# deepseek/deepseek-v4-flash-0731, qwen/qwen3.7-flash
# AI_CHAT_MODEL=z-ai/glm-5.3-flash

# Coupe le chat sans redéploiement (laisser vide ou absent = ouvert).
# AI_CHAT_ENABLED=false

# --- Projets (optionnel) ---
# Token GitHub (fine-grained, lecture publique) : augmente le plafond API
# de 60 à 5 000 requêtes/h pour la lecture des dépôts. Sans lui, tout marche.
# GITHUB_TOKEN=ghp_votre_token
